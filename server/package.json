{
  "name": "nirmala-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nirmala Enterprises Agro Management System - Express/Mongoose API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=src/app.js --watch-path=src/server.js --watch-path=src/routes --watch-path=src/middleware --watch-path=src/models --watch-path=src/services --watch-path=src/config src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:demo": "node src/scripts/seed.js --demo",
    "verify": "node src/scripts/verify-integrity.js",
    "verify:acceptance": "node src/scripts/verify-acceptance.mjs",
    "recompute": "node src/scripts/recompute-stock.js",
    "test:atomicity": "node src/scripts/test-atomicity.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^9.9.3",
    "morgan": "^1.10.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
