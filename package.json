{
  "name": "nirmala-enterprises",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix server run dev",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "seed:demo": "npm --prefix server run seed:demo",
    "verify": "npm --prefix server run verify",
    "verify:acceptance": "npm --prefix server run verify:acceptance",
    "recompute": "npm --prefix server run recompute",
    "test:atomicity": "npm --prefix server run test:atomicity",
    "sync": "node scripts/sync-data.mjs pull",
    "sync:pull": "node scripts/sync-data.mjs pull",
    "sync:push": "node scripts/sync-data.mjs push",
    "deploy": "wrangler pages deploy server/public --project-name=nirmala-enterprises --branch=main"
  },
  "devDependencies": {
    "wrangler": "^4.131.0"
  }
}
